{
  "name": "@cms/scip-processor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc && cp src/scip.proto dist/scip.proto",
    "start": "node dist/worker.js",
