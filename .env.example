# PostgreSQL
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=changeme

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme

# Core Service
PORT=3000
LOG_LEVEL=info

# Static bearer tokens (MVP only — replace with OIDC in v1)
CMS_CI_TOKEN=ci-secret-token
CMS_CLIENT_TOKEN=client-secret-token

# SCIP upload limits
MAX_SCIP_SIZE_MB=200
